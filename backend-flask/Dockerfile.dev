# 로컬 개발용. Lambda 런타임과 같은 Python 3.12를 쓴다.
# 시스템 패키지는 기존 backend/Dockerfile과 같다 (LibreOffice: 미리보기/PDF 변환, 폰트: 문서 생성).
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
      libreoffice \
      poppler-utils \
      fonts-nanum \
      fonts-noto-cjk \
    && fc-cache -f \
    && rm -rf /var/lib/apt/lists/*

# 무거운 모델 의존성은 별도 레이어 - 앱 의존성만 바뀌면 이 레이어 캐시를 그대로 쓴다.
COPY requirements-models.txt .
RUN pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cpu -r requirements-models.txt

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

ENV FLASK_APP=app:create_app FLASK_DEBUG=1 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
CMD ["flask", "run", "--host", "0.0.0.0", "--port", "5000"]
